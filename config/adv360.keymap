#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-while-undecided-linger;
            quick-tap-ms = <150>;
            hold-trigger-on-release;
        };

        hm_crtl: hm_crtl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_CRTL";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <175>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctr+shift+alt+tab_OK {
            bindings = <&kp LC(LA(LS(TAB)))>;
            key-positions = <15 16>;
        };

        enter_OK {
            bindings = <&kp RETURN>;
            key-positions = <33 32>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        tab_OK {
            bindings = <&kp TAB>;
            key-positions = <33 31>;
        };

        game_layer_OK {
            bindings = <&tog 3>;
            key-positions = <33 34>;
        };

        sublime_text_OK {
            bindings = <&kp LC(LA(LS(S)))>;
            key-positions = <30 19>;
        };

        teems_OK {
            bindings = <&kp LC(LA(LS(E)))>;
            key-positions = <19 17 65>;
            slow-release;
        };

        keypad_V2_OK {
            bindings = <&tog 6>;
            key-positions = <42 43 41>;
        };

        lang_change_OK {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <32 30>;
        };

        crtl+a_OK {
            bindings = <&kp LC(A)>;
            key-positions = <29 65>;
        };

        Crtl_Shift_S_OK {
            bindings = <&kp LC(LS(S))>;
            key-positions = <30 65>;
        };

        space_f_to_+ {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <32 65>;
        };

        ctrl_shift_home_OK {
            bindings = <&kp LC(LS(HOME))>;
            key-positions = <33 65>;
            layers = <0>;
        };

        ctrl_shif_end_OK {
            bindings = <&kp LC(LS(END))>;
            key-positions = <51 65>;
            layers = <0>;
        };

        space+d_to_change_lang_v2 {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <31 66>;
        };

        under_score {
            bindings = <&kp UNDERSCORE>;
            key-positions = <44 66>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <43 66>;
        };

        test1 {
            bindings = <&kp LS(MINUS)>;
            key-positions = <26 66>;
        };

        test2 {
            bindings = <&kp MINUS>;
            key-positions = <27 66>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_Layer {
            bindings = <
&kp EQUAL  &kp NUMBER_1            &kp NUMBER_2            &kp NUMBER_3            &kp N4                  &kp N5               &tog 6                                                                             &mo 4            &kp N6  &kp N7  &kp N8     &kp N9                &kp N0              &kp MINUS
&kp TAB    &kp Q                   &hm LC(LS(NUMBER_1)) W  &hm LC(LS(NUMBER_2)) E  &hm LC(LS(NUMBER_3)) R  &hm LC(LA(LS(T))) T  &mt LA(NUMBER_5) KP_N1                                                             &kp KP_NUMBER_4  &kp Y   &kp U   &kp I      &kp O                 &kp P               &kp LEFT_BRACKET
&kp ESC    &hm_shift LEFT_SHIFT A  &kp S                   &hm LCTRL D             &hm EQUAL F             &hm LC(LA(LS(G))) G  &kp KP_N2               &kp LCTRL     &mt LALT LEFT_WIN      &kp RMETA  &kp RCTRL  &kp KP_NUMBER_4  &kp H   &kp J   &kp K      &hm LC(L) L           &kp SEMI            &kp SQT
&kp LSHFT  &kp Z                   &kp X                   &hm LC(C) C             &hm LC(V) V             &hm COMMA B                                                &kp HOME               &kp PG_UP                              &kp N   &kp M   &kp COMMA  &kp DOT               &hm LC(FSLH) SLASH  &kp RSHFT
&mo 3      &kp GRAVE               &kp LC(LEFT_SHIFT)      &hm LA(LEFT) LEFT       &hm LA(RIGHT) RIGHT                          &kp SPACE               &lt 1 DELETE  &kp END                &kp PG_DN  &kp ENTER  &kp BACKSPACE            &kp UP  &kp DOWN   &kp NON_US_BACKSLASH  &kp RBKT            &mo 3
            >;
        };

        Layer_Work {
            bindings = <
&trans  &trans             &trans           &kp F4                     &trans                       &trans            &trans                                      &trans  &trans  &trans                &trans                 &trans     &trans          &trans
&trans  &kp LC(Q)          &kp LC(W)        &kp F2                     &trans                       &kp LG(LC(T))     &trans                                      &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &trans          &trans
&trans  &hm HOME LC(HOME)  &hm END LC(END)  &mt LG(LC(LEFT)) LG(LEFT)  &mt LG(LC(RIGHT)) LG(RIGHT)  &kp LC(F)         &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp UNDERSCORE  &trans
&trans  &trans             &trans           &kp LC(PG_UP)              &kp LC(PAGE_DOWN)            &kp LC(LS(DOWN))                  &trans      &trans                  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans     &trans          &trans
&trans  &trans             &kp CAPS         &kp LC(LS(LEFT))           &kp LC(LS(RIGHT))                              &trans  &trans  &trans      &trans  &trans  &trans          &trans                &trans                 &trans     &trans          &trans
            >;
        };

        keypad_and_game {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                     &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp Q     &kp W     &kp E      &kp R   &kp T                                                      &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp LSHFT  &kp A     &kp S     &kp D      &kp F   &kp G      &kp DELETE  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                          &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp LCTRL   &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 3                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        tech {
            bindings = <
&trans     &trans  &trans  &trans    &trans     &trans  &trans                                                    &trans    &trans  &trans  &trans     &trans   &trans    &trans
&trans     &kp Q   &kp W   &kp E     &kp R      &kp T   &tog 5                                                    &kp LEFT  &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&kp ESC    &kp A   &kp S   &kp D     &kp F      &kp G   &kp DOWN   &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &kp LEFT  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B                         &kp HOME      &kp PG_UP                       &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans     &trans  &trans  &kp LEFT  &kp RIGHT          &kp SPACE  &kp DEL    &kp END       &kp PG_DN  &kp RET    &kp BSPC          &kp UP  &kp DOWN   &trans   &trans    &trans
            >;
        };

        Keypad_V2 {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                    &trans    &trans  &trans  &kp FSLH  &kp LS(N8)        &trans            &trans
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 5                                                    &none     &kp Y   &kp N7  &kp N8    &kp N9            &kp MINUS         &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none     &kp H   &kp N4  &kp N5    &kp N6            &kp LS(EQUAL)     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &kp HOME      &kp PG_UP                       &kp N   &kp N1  &kp N2    &kp N3            &hm COMMA PERIOD  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp BSPC          &kp N0  &kp N0    &hm COMMA PERIOD  &kp RBKT          &mo 3
            >;
        };
    };
};
